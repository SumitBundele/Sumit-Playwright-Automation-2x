//Pure Function
//A pure function is a function that always produces the same output for the same input
//  and has no side effects.

function calculatePassrate(passed, total) {
    return (passed / total) * 100; tofixed(2);
}

console.log(calculatePassrate(80, 100)); // 80
console.log(calculatePassrate(70, 100)); // 70

//Impure Function --Depends on external state or has side effects
function isPassing(score) {
    return score >= threshold;
}
let threshold = 60;
console.log(isPassing(70)); // true
console.log(isPassing(50)); // false